# Supabase（服务端密钥禁止使用 NEXT_PUBLIC_ 前缀）
# Coze 可继续注入 COZE_*；直接连接 Supabase 时也支持
# SUPABASE_URL / SUPABASE_PUBLISHABLE_KEY / SUPABASE_SERVICE_ROLE_KEY。
COZE_SUPABASE_URL=https://your-project.supabase.co
COZE_SUPABASE_ANON_KEY=your-publishable-key
COZE_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI大模型：通过 coze-coding-dev-sdk（LLMClient）调用平台内置模型，鉴权由平台自动注入，无需配置任何 Token。

# 仅允许本地开发使用AI固定夹具；生产环境即使误设也不会生效。
ENABLE_AI_FIXTURE=false
# 仅本地视觉验收时开启/preview/student和/preview/teacher；生产必须关闭。
ENABLE_UI_PREVIEW=false

# 开发阶段演示身份。默认关闭；仅本地验收时临时开启。
ENABLE_DEMO_ACCESS=false

# 超星OAuth后置开关
ENABLE_CHAOXING_AUTH=false
CHAOXING_APPID=your-appid
CHAOXING_SECRET=your-appkey
CHAOXING_FIDS=your-wuhan-university-fid
CHAOXING_REDIRECT_URI=https://your-domain/api/auth/callback/chaoxing
# 教师角色只认稳定 roleId（逗号分隔），不使用“教师/teacher”等角色名称猜测。
CHAOXING_TEACHER_ROLE_IDS=

# 超星表单外部留痕。默认 disabled；取得已发布任务流/API契约后再切换。
CHAOXING_FORM_ID=3513491
CHAOXING_FORM_TRANSPORT=disabled
CHAOXING_FORM_WRITE_URL=
CHAOXING_FORM_WRITE_TOKEN=
CHAOXING_FORM_READBACK_URL=
CHAOXING_FORM_RATE_LIMIT=2

# 超星智能体内嵌网页桥接（公开任务流 ID，不包含密钥）
# 仅在页面运行于受信任的 robot*.chaoxing.com 容器时发送；服务端 outbox 仍是可靠留痕。
NEXT_PUBLIC_CHAOXING_TASKFLOW_ID=153154
SYNC_WORKER_SECRET=generate-a-long-random-secret

# Coze运行环境
COZE_PROJECT_DOMAIN_DEFAULT=
COZE_PROJECT_ENV=
