{
  "name": "luojia-biochemistry-agent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "bash ./scripts/build.sh",
    "dev": "bash ./scripts/dev.sh",
    "preinstall": "only-allow pnpm",
    "lint": "eslint",
    "lint:build": "eslint . --quiet",
    "start": "bash ./scripts/start.sh",
    "ts-check": "tsc -p tsconfig.json",
    "gen:env": "node scripts/gen-env.js",
    "seed:content": "tsx scripts/seed-agent-content.ts",
    "export:knowledge": "tsx scripts/export-knowledge.ts",
    "test": "tsx --test tests/**/*.test.ts",
    "validate": "pnpm run ts-check && pnpm run lint:build",
    "bundle": "node ./scripts/bundle.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "2.110.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "coze-coding-dev-sdk": "^0.7.24",
    "dotenv": "^17.2.3",
    "lucide-react": "^0.468.0",
    "next": "16.1.1",
    "pg": "8.17.2",
    "pg-connection-string": "2.10.1",
    "pg-int8": "1.0.1",
    "pg-pool": "3.11.0",
    "pg-protocol": "1.11.0",
    "pg-types": "2.2.0",
    "pgpass": "1.0.5",
    "postgres-array": "2.0.0",
    "postgres-bytea": "1.0.1",
    "postgres-date": "1.0.7",
    "postgres-interval": "1.2.0",
    "radix-ui": "^1.5.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^2.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@react-dev-inspector/babel-plugin": "^2.0.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "only-allow": "^1.2.2",
    "react-dev-inspector": "^2.0.1",
    "shadcn": "latest",
    "tailwindcss": "^4",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "pnpm": ">=9.0.0"
  }
}
